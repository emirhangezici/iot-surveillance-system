# Optional. The local demo works without this file.
# A random persistent signing key is stored in instance/secret.key automatically.
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

SQLITE_DATABASE=instance/sentinel.sqlite3
SEED_DEMO=true
# Enable only when serving over HTTPS.
SECURE_COOKIES=false

# Optional standalone serial diagnostic; not connected to the web demo.
SERIAL_PORT=COM4
BAUD_RATE=9600
