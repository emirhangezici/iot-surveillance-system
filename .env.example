# Copy this file to .env and fill in local values. Never commit .env.

# Flask session signing key (generate a long random string)
SECRET_KEY=replace-me-with-a-long-random-string

# Microsoft Access database file (keep this file local; it is gitignored)
DATABASE_PATH=./IoT_ Database.accdb
DATABASE_DRIVER={Microsoft Access Driver (*.mdb, *.accdb)}

# Arduino serial connection
SERIAL_PORT=COM4
BAUD_RATE=9600
